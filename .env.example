# ─────────────────────────────────────────────────────────────
#  Afaura Luméa — variables d'environnement
#  Copier ce fichier en .env.local puis remplir les valeurs.
#  Rien de sensible ici : tout ce qui commence par VITE_ est
#  visible dans le navigateur (voir README, section Sécurité).
# ─────────────────────────────────────────────────────────────

# Numéro WhatsApp de la boutique, format international SANS "+" ni espaces.
# Ex : 221771234567. C'est la SEULE façon d'envoyer un message déjà rédigé
# (récapitulatif de commande, demande SHEIN) : à privilégier.
VITE_WHATSAPP_NUMBER=""

# Lien court WhatsApp Business (wa.me/message/XXXX) — solution de repli.
# Il ouvre la conversation mais ne peut PAS transporter de message pré-rempli :
# le site copie alors le message dans le presse-papier avant d'ouvrir WhatsApp.
VITE_WHATSAPP_LINK="https://wa.me/message/A4C6VTCHWW4QH1"

# Clôture du prochain groupage, au format ISO 8601.
# Laisser vide tant que la date n'est pas fixée : aucun compte à rebours ne s'affiche.
VITE_NEXT_GROUPING_DATE=""

# Numéros marchands affichés dans les instructions de paiement (facultatif).
VITE_WAVE_NUMBER=""
VITE_ORANGE_MONEY_NUMBER=""

# Contact et réseaux (facultatif).
VITE_CONTACT_EMAIL=""
VITE_INSTAGRAM_HANDLE=""

# URL publique du site, utilisée pour le SEO, l'Open Graph et le sitemap.
VITE_SITE_URL=""

# Code d'accès de l'espace admin EN MODE LOCAL uniquement.
# Ce n'est PAS une sécurité serveur : voir README pour l'authentification Supabase.
VITE_ADMIN_PASSCODE="lumea-admin"

# ── Supabase (facultatif) ────────────────────────────────────
# Dès que ces deux valeurs sont renseignées, l'application bascule
# du stockage navigateur vers Postgres : commandes partagées entre
# appareils, admin protégé par Supabase Auth, montants recalculés côté serveur.
# Exécuter d'abord supabase/schema.sql dans le SQL editor du projet.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
